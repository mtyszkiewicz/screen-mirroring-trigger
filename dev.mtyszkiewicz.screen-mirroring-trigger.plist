<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.mtyszkiewicz.screen-mirroring-trigger</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/screen-mirroring-trigger</string>
        <string>-cooldown</string>
        <string>30</string>
        <string>-command</string>
        <string>curl -X PUT http://10.205.0.5:8001/profile?name=tv</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/screen-mirroring-trigger.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/screen-mirroring-trigger.err</string>
</dict>
</plist>
